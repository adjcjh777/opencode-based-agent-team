{
  "name": "codexagentteams",
  "version": "0.1.0",
  "description": "Node.js CLI with Agent Teams capabilities",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "ai": "^4.3.19",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "ink": "^5.2.1",
    "react": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
